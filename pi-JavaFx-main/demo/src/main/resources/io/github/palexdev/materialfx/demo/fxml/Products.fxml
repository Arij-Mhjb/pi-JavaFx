<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.palexdev.materialfx.demo.controllers.ProductController">
    <GridPane styleClass="scroll-pane" stylesheets="@../css/ProductCard.css">
        <FlowPane fx:id="addButtonContainer" alignment="CENTER" hgap="20" vgap="20">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <MFXButton fx:id="addProductButton" buttonType="RAISED" onAction="#handleAddNewProduct" styleClass="Add-button" stylesheets="@../css/ProductCard.css" text="Add Product" />
            <MFXButton fx:id="switchToStoreButton" buttonType="RAISED" onAction="#switchToStore" styleClass="Add-button" stylesheets="@../css/ProductCard.css" text="Switch to Store" />
        </FlowPane>
        <columnConstraints>
            <ColumnConstraints />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
        <MFXTextField fx:id="searchField" promptText="Search by product name" />
        <MFXComboBox fx:id="categoryFilter" promptText="Filter by category" />
        <MFXComboBox fx:id="stockFilter" promptText="Filter by stock" />
        <MFXButton text="Filter" onAction="#filterProducts" />
        <MFXButton text="Return" onAction="#resetFilters" />
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="scroll-pane" stylesheets="@../css/ProductCard.css">
        <FlowPane fx:id="cardsContainer" alignment="CENTER" hgap="20" vgap="20">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <!-- Dynamic product cards will be added here by the controller -->
        </FlowPane>
    </ScrollPane>
</VBox>